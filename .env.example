# Llave pública de Web3Forms para el formulario de contacto.
# Sin ella, el formulario abre WhatsApp con el mensaje ya armado.
# Obtén una gratis en https://web3forms.com (llega a tu correo, 250 envíos/mes).
VITE_WEB3FORMS_KEY=

# Solo si reactivas el asistente de IA (está desactivado en producción).
# Ojo: Vite la inlinea en el bundle público, así que debe ir por un proxy.
GEMINI_API_KEY=
